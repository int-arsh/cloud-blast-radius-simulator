# Application Environment Configuration Example
APP_NAME="Cloud Blast-Radius Simulator"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false

# Server Settings
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Limits
MAX_PLAN_SIZE_BYTES=10485760
ANALYSIS_TIMEOUT_SECONDS=30

# Logging
LOG_LEVEL="INFO"
LOG_JSON=true
